# Example environment for openai-limit-optimizer (copy, don't commit secrets).
# The daemon polls Codex usage every OLO_POLL_SECONDS (default 600) and only
# sends OLO_PROMPT via a fresh ephemeral session when the conservative
# moving-full-window policy matches. No API keys, billing, reset-credit
# redemption or Luna Reserve are ever used (supportsLunaReserve=false).
OLO_IMAGE=simeonevilardo/openai-limit-optimizer:latest
OLO_DATA_DIR=./data
OLO_UID=65532
OLO_GID=65532
OLO_POLL_SECONDS=600
OLO_CONFIRM_SECONDS=30
OLO_MODEL=gpt-5.6-luna
OLO_EFFORT=low
OLO_PROMPT=Answer only with "hi"
OLO_RPC_TIMEOUT=60
OLO_SEND_TIMEOUT=300
OLO_COOLDOWN_SECONDS=18000
# Optional daily local reset targets. Empty disables the env schedule.
OLO_RESET_TIMES=
# IANA timezone used by OLO_RESET_TIMES (for example Europe/Rome).
OLO_RESET_TIMEZONE=UTC
# Runtime `schedule set/clear/reset` override; keep it beside persistent state.
OLO_SCHEDULE_FILE=/data/schedule.json
